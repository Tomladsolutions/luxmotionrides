# Copy to `.env.local` and fill in real values. Never commit real keys.

# Google Maps JavaScript API key (Places Autocomplete + Reviews).
# This key is exposed to the browser, so restrict it in the Google Cloud
# Console by HTTP referrer and by API (Maps JavaScript API, Places API).
VITE_GOOGLE_MAPS_API_KEY=

# AviationStack API key for flight tracking.
VITE_AVIATIONSTACK_API_KEY=

# Google Gemini API key (only if the AI features are enabled).
GEMINI_API_KEY=
